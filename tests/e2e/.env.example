# Optional. Unclaimed Plex is sufficient for server-health and anonymous catalog
# smoke tests because the fixture only binds to 127.0.0.1.
#
# A claim token is short-lived and is used only the first time a fresh Plex
# config volume starts. Obtain one from https://www.plex.tv/claim.
PLEX_CLAIM=

# Required for claimed-server catalog setup and future per-user watch-state E2E.
# Use a token belonging only to a disposable Plex test account.
PLEX_TOKEN=

JELLYFIN_PORT=18096
PLEX_PORT=32410
TZ=America/Los_Angeles
