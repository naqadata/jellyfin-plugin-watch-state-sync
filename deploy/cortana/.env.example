# This stack is intentionally for disposable development use.
JELLYFIN_USERNAME=pauldwitt
JELLYFIN_PASSWORD=change-me-before-deploy
JELLYFIN_ENABLE_REMOTE_ACCESS=true
JELLYFIN_SERVER_NAME=Cortana Watch Sync Dev

JELLYFIN_PORT=18096
PLEX_PORT=32410
BIND_ADDRESS=0.0.0.0
JELLYFIN_PUBLISHED_URL=http://cortana:18096
PLEX_ADVERTISE_IP=http://cortana:32410/
TZ=America/Los_Angeles

# Optional. The server can instead be claimed interactively in Plex Web.
# Obtain a short-lived value from https://www.plex.tv/claim.
PLEX_CLAIM=

# Needed after claiming for authenticated API calls and watch-state sync.
# Use a token for the disposable Plex test account.
PLEX_TOKEN=
